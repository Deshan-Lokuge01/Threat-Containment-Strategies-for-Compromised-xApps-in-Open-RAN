{
  "name": "__XAPP_NAME__",
  "version": "__XAPP_VERSION__",
  "provider": "__PROVIDER_ID__",
  "containers": [
    {
      "name": "__XAPP_NAME__",
      "image": {
        "registry": "__IMAGE_REGISTRY__",
        "name": "__IMAGE_NAME__",
        "tag": "__IMAGE_TAG__",
        "digest": "__IMAGE_DIGEST__",
        "reference": "__IMAGE_REFERENCE__",
        "immutable_reference": "__IMMUTABLE_IMAGE_REFERENCE__"
      }
    }
  ],
  "messaging": {
    "ports": [
      {
        "name": "http_service",
        "container": "__XAPP_NAME__",
        "port": 8092,
        "description": "HTTP API for health, profile, activity, RIC/E2 checks, subscription status, and metrics"
      },
      {
        "name": "rmr_data",
        "container": "__XAPP_NAME__",
        "port": 4562,
        "description": "RMR data port for O-RAN RIC indications, subscription responses, and failures"
      }
    ],
    "rmr": {
      "enabled": true,
      "port": 4562,
      "rxMessages": [
        "RIC_SUB_RESP",
        "RIC_SUB_FAILURE",
        "RIC_INDICATION",
        "RIC_CONTROL_ACK",
        "RIC_CONTROL_FAILURE"
      ],
      "txMessages": [
        "RIC_SUB_REQ"
      ]
    }
  },
  "oran": {
    "xappType": "real-kpm-monitor",
    "serviceModel": "E2SM-KPM",
    "e2NodeId": "gnbd_001_001_00019b_0",
    "ranFunctionId": 2,
    "kpmReportStyle": 1,
    "metrics": [
      "DRB.UEThpUl",
      "DRB.UEThpDl"
    ],
    "submgrUri": "http://ztx-submgr-http.ricplt.svc.cluster.local:8088/ric/v1",
    "e2mgrNodebStatesUrl": "http://service-ricplt-e2mgr-http.ricplt.svc.cluster.local:3800/v1/nodeb/states"
  },
  "livenessProbe": {
    "httpGet": {
      "path": "/health",
      "port": 8092
    },
    "initialDelaySeconds": 15,
    "periodSeconds": 15
  },
  "readinessProbe": {
    "httpGet": {
      "path": "/health",
      "port": 8092
    },
    "initialDelaySeconds": 15,
    "periodSeconds": 15
  },
  "security": {
    "serviceAccount": "__XAPP_NAME__",
    "spiffeID": "spiffe://__TRUST_DOMAIN__/ns/__NAMESPACE__/sa/__XAPP_NAME__",
    "requiresSVID": true,
    "runAsNonRoot": true,
    "allowPrivilegeEscalation": false
  }
}
