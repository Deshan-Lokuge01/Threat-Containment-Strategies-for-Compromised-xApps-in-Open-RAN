{
  "xapp": "__XAPP_NAME__",
  "role": "real-oran-kpm-monitor",
  "controls": {
    "expected_cpu_class": "medium",
    "expected_memory_class": "medium",
    "expected_ric_activity": true,
    "expected_control_activity": false,
    "expected_shell": false,
    "expected_sensitive_file_access": false,
    "expected_external_egress": false,
    "expected_cross_xapp_comm": false,
    "heartbeat_period_sec": 5,
    "workload_intensity": "medium",
    "allowed_ric_services": [
      "e2mgr",
      "submgr",
      "prometheus"
    ],
    "allowed_e2_nodes": [
      "gnbd_001_001_00019b_0"
    ],
    "max_api_rate_per_min": 120
  },
  "oran": {
    "enabled": true,
    "mode": "kpm-subscription-stage-1",
    "service_model": "E2SM-KPM",
    "e2_node_id": "gnbd_001_001_00019b_0",
    "ran_function_id": 2,
    "kpm_report_style": 1,
    "metrics": [
      "DRB.UEThpUl",
      "DRB.UEThpDl"
    ],
    "submgr_uri": "http://ztx-submgr-http.ricplt.svc.cluster.local:8088/ric/v1",
    "e2mgr_nodeb_states_url": "http://service-ricplt-e2mgr-http.ricplt.svc.cluster.local:3800/v1/nodeb/states"
  },
  "messaging": {
    "ports": [
      {
        "name": "http_service",
        "container": "__XAPP_NAME__",
        "port": 8092,
        "description": "HTTP REST API for runtime status and metrics"
      },
      {
        "name": "rmr_data",
        "container": "__XAPP_NAME__",
        "port": 4562,
        "description": "RMR data port for RIC indications and subscription messages"
      }
    ]
  },
  "runtime_counters": {
    "e2_node_state": true,
    "subscription_attempts": true,
    "subscription_success": true,
    "subscription_failures": true,
    "rmr_messages_total": true,
    "rmr_indications_total": true
  },
  "security_monitoring": {
    "compromise_indicators": [
      "unexpected_shell_spawn",
      "sensitive_file_access",
      "service_account_token_access",
      "unexpected_external_egress",
      "high_cpu_without_ric_activity",
      "stale_heartbeat",
      "unexpected_rmr_traffic",
      "unexpected_submgr_subscription_behavior"
    ],
    "containment_actions": [
      "label_as_quarantined",
      "deny_all_network_policy",
      "preserve_pod_for_forensics"
    ]
  }
}
