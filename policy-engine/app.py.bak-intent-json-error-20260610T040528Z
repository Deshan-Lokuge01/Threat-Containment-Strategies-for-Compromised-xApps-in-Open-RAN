SERVICE_ISOLATED_ANNOTATION = "zt-xguard.io/service-isolated"
SERVICE_ISOLATED_INCIDENT_ANNOTATION = "zt-xguard.io/service-isolated-incident"
ORIGINAL_REPLICAS_ANNOTATION = "zt-xguard.io/original-replicas"


