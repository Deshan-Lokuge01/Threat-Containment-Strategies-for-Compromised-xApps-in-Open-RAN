def get_xapp_from_pod_or_name(pod: Optional[Any], pod_name: Optional[str]) -> str:
    try:
        if pod is not None:
            labels = pod.metadata.labels or {}
            if labels.get("app"):
                return labels.get("app")
    except Exception:
