import json as _ztx_v2_json
import uuid as _ztx_v2_uuid
import time as _ztx_v2_time

_ZTX_SURGICAL_CONTAINMENT_FIX_V2 = True

def _ztx_v2_services_for_xapp(xapp, namespace=None):
    namespace = namespace or XAPP_NAMESPACE
    services = []

    try:
        svc = CORE.read_namespaced_service(xapp, namespace)
        services.append(svc)
    except Exception:
        pass

    try:
        listed = CORE.list_namespaced_service(namespace, label_selector=f"app={xapp}")
        for svc in listed.items or []:
            if all(existing.metadata.name != svc.metadata.name for existing in services):
                services.append(svc)
    except Exception:
        pass

    return services

def _ztx_v2_patch_pod_quarantine_labels(xapp, namespace=None):
    namespace = namespace or XAPP_NAMESPACE
    patched = []

    try:
        pods = CORE.list_namespaced_pod(namespace, label_selector=f"app={xapp}").items or []
        for pod in pods:
            CORE.patch_namespaced_pod(
                pod.metadata.name,
                namespace,
                {
                    "metadata": {
                        "labels": {
                            "security-status": "quarantined",
                            "zt-xguard.io/quarantine": "true",
                            "zt-xguard.io/decision": "compromised",
                        },
                        "annotations": {
                            "zt-xguard.io/quarantine-time": _ztx_surgical_now(),
                            "zt-xguard.io/quarantine-reason": "ztx_surgical_containment_fix_v2",
                        },
                    }
                },
            )
            patched.append(pod.metadata.name)
    except Exception as exc:
        return {"patched": patched, "error": str(exc)}

    return {"patched": patched, "error": None}

def _ztx_v2_isolate_services(xapp, namespace=None, reason=None):
    namespace = namespace or XAPP_NAMESPACE
    reason = reason or "ztx_surgical_containment_fix_v2"
    token = "ztx-isolated-" + _ztx_v2_uuid.uuid4().hex[:12]
    results = []

    for svc in _ztx_v2_services_for_xapp(xapp, namespace):
        name = svc.metadata.name
        annotations = dict(svc.metadata.annotations or {})
        selector = dict(svc.spec.selector or {"app": xapp})

        # Preserve the real selector once so restore can put it back.
        original_raw = annotations.get("zt-xguard.io/original-service-selector")
        if original_raw:
            try:
                original_selector = _ztx_v2_json.loads(original_raw)
            except Exception:
                original_selector = {"app": xapp}
        else:
            original_selector = dict(selector)

        blocked_selector = dict(original_selector)
        blocked_selector["zt-xguard.io/service-isolated"] = token

        body = {
            "metadata": {
                "annotations": {
                    "zt-xguard.io/original-service-selector": _ztx_v2_json.dumps(original_selector),
                    "zt-xguard.io/service-isolated": "true",
                    "zt-xguard.io/service-isolated-time": _ztx_surgical_now(),
                    "zt-xguard.io/service-isolated-reason": reason,
                    "zt-xguard.io/service-isolated-token": token,
                }
            },
            "spec": {
                "selector": blocked_selector
            },
        }

        try:
            CORE.patch_namespaced_service(name, namespace, body)
            results.append({
                "service": name,
                "applied": True,
                "original_selector": original_selector,
                "blocked_selector": blocked_selector,
            })
        except Exception as exc:
            results.append({
                "service": name,
                "applied": False,
                "error": str(exc),
            })

    _ztx_v2_time.sleep(1.0)
    verification = _ztx_live_containment(xapp, namespace)

    return {
        "xapp": xapp,
        "namespace": namespace,
        "reason": reason,
        "services": results,
        "verification_after": verification,
        "service_isolation_applied": bool(verification.get("service_isolated")),
        "effective_containment_applied": bool(verification.get("contained")),
        "ztx_surgical_containment_fix_v2": True,
    }

_ZTX_V1_FORCE_CONTAINMENT = _ztx_force_containment_for_xapp

def _ztx_force_containment_for_xapp(xapp, namespace=None, reason=None):
    namespace = namespace or XAPP_NAMESPACE
    reason = reason or "ztx_surgical_force_containment_v2"

    # Keep existing behavior first: label pod, evidence annotations, audit.
    try:
        first = _ZTX_V1_FORCE_CONTAINMENT(xapp, namespace, reason)
    except Exception as exc:
        first = {"applied": False, "error": str(exc)}

    # Then force actual Service isolation if endpoint is still reachable.
    v = _ztx_live_containment(xapp, namespace)
    if not v.get("contained") or not v.get("service_isolated"):
        pod_patch = _ztx_v2_patch_pod_quarantine_labels(xapp, namespace)
        service_patch = _ztx_v2_isolate_services(xapp, namespace, reason)
        v = service_patch.get("verification_after") or _ztx_live_containment(xapp, namespace)
    else:
        pod_patch = {"skipped": True}
        service_patch = {"skipped": True, "verification_after": v}

    return {
        "xapp": xapp,
        "namespace": namespace,
        "reason": reason,
        "v1_result": first,
        "pod_patch": pod_patch,
        "service_patch": service_patch,
        "verification_after": v,
        "service_isolation_applied": bool(v.get("service_isolated")),
        "effective_containment_applied": bool(v.get("contained")),
        "ztx_surgical_containment_fix_v2": True,
    }

