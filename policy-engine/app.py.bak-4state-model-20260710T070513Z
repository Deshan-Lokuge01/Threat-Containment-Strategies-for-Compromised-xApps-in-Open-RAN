    while True:
        try:
            build_report(persist=True, reason="scheduled_scan")
        except Exception as exc:
            print(json.dumps({"component": "zt-xguard-policy-engine", "scanner_error": str(exc), "trace": traceback.format_exc()}), flush=True)
