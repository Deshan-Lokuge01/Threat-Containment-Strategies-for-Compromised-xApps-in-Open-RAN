[Unit]
Description=ZT-XGuard T2 resource-anomaly collector for kpimon-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/nearric
Environment=KUBECONFIG=/home/nearric/.kube/config
WorkingDirectory=/home/nearric/Desktop/FYP/zt-xguard/ztx-control-plane/policy-engine
ExecStart=/home/nearric/Desktop/FYP/zt-xguard/ztx-control-plane/policy-engine/.t2-collector-venv/bin/python3 ztx_t2_collector.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
