(function ztxBlockOldDashboardIntervals() {
  const nativeSetInterval = window.setInterval;
  window.setInterval = function(fn, delay, ...args) {
    const src = String(fn || "");
    const d = Number(delay || 0);

    // Block old slow dashboard loops that cause compact/flicker redraws.
    if (
      d >= 10000 &&
      (
        src.includes("refreshDashboard") ||
        src.includes("refreshRuntime") ||
        src.includes("renderRuntime") ||
        src.includes("loadRuntime")
      ) &&
      !src.includes("ztxStableRefreshDashboard")
    ) {
      console.log("[ZT-XGuard] blocked old dashboard interval", d);
      return 0;
    }

    return nativeSetInterval(fn, delay, ...args);
  };
})();

const ztx$ = (id) => document.getElementById(id);
const ztxEsc = (v) => {
  if (typeof esc === "function") return esc(v);
  return String(v ?? "").replace(/[&<>"']/g, c => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  }[c]));
};
const ztxSetText = (id, value) => {
  if (typeof setText === "function") return setText(id, value);
  const el = ztx$(id);
  if (el) el.textContent = value;
};
const ztxAsArray = (v) => {
  if (typeof asArray === "function") return asArray(v);
  return Array.isArray(v) ? v : [];
};
const ztxApiJson = async (url, opts) => {
  if (typeof apiJson === "function") return apiJson(url, opts);
  const r = await fetch(url, opts);
  return await r.json();
};

function ztxN(v) {
  const n = Number(v);
  return Number.isFinite(n) ? n : null;
}

function ztxScore(v) {
  const n = ztxN(v);
  return n === null ? "N/A" : String(Math.round(n));
}

function ztxCpu(resources) {
  const v = ztxN(resources?.cpu_percent_1core ?? resources?.cpu_percent_1core_2m);
  return v === null ? "N/A" : `${v.toFixed(1)}%`;
}

function ztxMem(resources) {
  const b = ztxN(resources?.memory_working_set_bytes ?? resources?.memory_usage_bytes);
  if (b === null) return "N/A";
  return `${(b / 1024 / 1024).toFixed(1)} Mi`;
}

function ztxStateClassV2(state) {
  const s = String(state || "UNKNOWN").toUpperCase();
  if (s === "TRUSTED" || s === "RESTORED") return "healthy";
  if (s === "OBSERVED") return "observed";
  if (s === "SUSPICIOUS") return "suspicious";
  if (s === "COMPROMISED" || s === "QUARANTINED") return "compromised";
  return "unknown";
}

function ztxPillV2(text, cls) {
  return `<span class="pill ${cls || "unknown"}">${ztxEsc(text)}</span>`;
}

function ztxYesNoV2(value) {
  return value
    ? `<span class="pill compromised">YES</span>`
    : `<span class="pill healthy">NO</span>`;
}

function ztxCanonicalScoresV2(s) {
  const state = String(s?.state || "UNKNOWN").toUpperCase();

  let risk = ztxN(s?.risk_score);
  let trust = ztxN(s?.trust_score);
  const raw = ztxN(s?.score);
  const scoreType = String(s?.score_type || "").toLowerCase();

  if (risk === null && trust === null && raw !== null) {
    if (scoreType.includes("risk")) {
      risk = raw;
      trust = 100 - risk;
    } else if (scoreType.includes("trust")) {
      trust = raw;
      risk = 100 - trust;
    } else if (state === "TRUSTED" || state === "RESTORED") {
      trust = raw;
      risk = 100 - trust;
    } else if (state === "COMPROMISED" || state === "QUARANTINED") {
      risk = 100;
      trust = 0;
    } else {
      trust = raw;
      risk = 100 - trust;
    }
  }

  if (risk === null && trust !== null) risk = 100 - trust;
  if (trust === null && risk !== null) trust = 100 - risk;

  if (state === "TRUSTED" || state === "RESTORED") {
    risk = 0;
    trust = 100;
  } else if (state === "OBSERVED") {
    if (risk === null || risk > 40) risk = 20;
    trust = 100 - risk;
  } else if (state === "SUSPICIOUS") {
    if (risk === null || risk < 50) risk = 60;
    trust = 100 - risk;
  } else if (state === "COMPROMISED" || state === "QUARANTINED") {
    risk = 100;
    trust = 0;
  }

  return { risk, trust };
}

function ztxEffectiveContainmentV2(runtime, trust) {
  const state = String(trust?.state || "").toUpperCase();

  // Dashboard-level meaning:
  // If policy engine state is QUARANTINED, show containment as YES.
  if (state === "QUARANTINED") return true;

  const c = runtime?.containment || {};
  if (c.contained === true) return true;

  const svc = runtime?.service || {};
  const pod = runtime?.pod || {};

  const quarantineMarked =
    c.quarantine_marked === true ||
    c.pod_labelled_quarantined === true ||
    pod.quarantine_label === true;

  const serviceIsolated =
    c.service_isolated === true ||
    svc.has_endpoints === false ||
    Number(svc.endpoint_count) === 0;

  return quarantineMarked && serviceIsolated;
}

function ztxMergeRowsV2(statePayload, runtimePayload) {
  const stateByXapp = {};
  ztxAsArray(statePayload?.xapps).forEach(x => {
    if (x?.xapp) stateByXapp[x.xapp] = x;
  });

  return ztxAsArray(runtimePayload?.rows).map(r => ({
    runtime: r,
    trust: stateByXapp[r.xapp] || {}
  }));
}

let ztxRefreshInFlight = false;
let ztxLastGoodRowsHtml = "";

async function ztxStableRefreshDashboard() {
  if (ztxRefreshInFlight) return;
  ztxRefreshInFlight = true;

  try {
    const [stateResult, runtimeResult] = await Promise.allSettled([
      ztxApiJson("/csm/state"),
      ztxApiJson("/csm/xapps/runtime-lite?namespace=ricxapp")
    ]);

    const state = stateResult.status === "fulfilled" ? stateResult.value : {};
    const runtime = runtimeResult.status === "fulfilled" ? runtimeResult.value : {};
    const rows = ztxMergeRowsV2(state, runtime);

    const overall = state?.overall_state || "INITIALIZING";
    ztxSetText("overallState", overall);

    const summary = state?.summary || {};
    ztxSetText("trustedCount", summary.TRUSTED ?? 0);
    ztxSetText("observedCount", summary.OBSERVED ?? 0);
    ztxSetText("suspiciousCount", summary.SUSPICIOUS ?? 0);
    ztxSetText("compromisedCount", summary.COMPROMISED ?? 0);
    ztxSetText("quarantinedCount", summary.QUARANTINED ?? 0);

    const tbody =
      ztx$("runtimeBody") ||
      document.querySelector("#runtimeTable tbody") ||
      document.querySelector("table tbody");

    if (!tbody) return;

    if (!rows.length) {
      if (!ztxLastGoodRowsHtml) {
        tbody.innerHTML = `<tr><td colspan="11">Waiting for runtime data...</td></tr>`;
      }
      return;
    }

    const html = rows.map(({ runtime: r, trust: s }) => {
      const pod = r.pod || {};
      const svc = r.service || {};
      const res = r.resources || {};

      const stateText = s.state || "UNKNOWN";
      const scores = ztxCanonicalScoresV2(s);
      const contained = ztxEffectiveContainmentV2(r, s);

      const endpointCount = svc.endpoint_count ?? "N/A";
      const podName = pod.name || "N/A";
      const readyText = pod.ready_text || "N/A";

      return `
        <tr>
          <td><b>${ztxEsc(r.xapp || "unknown")}</b></td>
          <td>${ztxPillV2(stateText, ztxStateClassV2(stateText))}</td>
          <td>${ztxScore(scores.risk)}</td>
          <td>${ztxScore(scores.trust)}</td>
          <td>${ztxCpu(res)}</td>
          <td>${ztxMem(res)}</td>
          <td>${ztxEsc(podName)}</td>
          <td>${ztxEsc(readyText)}</td>
          <td>${ztxEsc(endpointCount)}</td>
          <td>${ztxYesNoV2(contained)}</td>
          <td><button class="btn analyze-btn" data-xapp="${ztxEsc(r.xapp || "")}">Analyze</button></td>
        </tr>
      `;
    }).join("");

    ztxLastGoodRowsHtml = html;
    tbody.innerHTML = html;

    const updated = ztx$("updatedAt") || ztx$("runtimeUpdatedAt");
    if (updated) updated.textContent = "Updated " + new Date().toLocaleTimeString();

  } catch (err) {
    console.warn("[ZT-XGuard] stable refresh failed", err);
  } finally {
    ztxRefreshInFlight = false;
  }
}

async function ztxStablePrimeState() {
  const xapps = [
    "telemetry-monitor",
    "qos-optimizer",
    "traffic-analyzer",
    "resource-optimizer",
    "security-observer"
  ];

  await Promise.allSettled(xapps.map(x =>
    ztxApiJson("/csm/intent/ingest", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({xapp: x, signal: "clean_baseline", source: "dashboard_stable_prime"})
    })
  ));

  await ztxStableRefreshDashboard();
}

window.refreshDashboard = ztxStableRefreshDashboard;
window.refreshRuntime = ztxStableRefreshDashboard;
window.ztxStableRefreshDashboard = ztxStableRefreshDashboard;

document.addEventListener("click", (ev) => {
  const el = ev.target.closest("button, a");
  if (!el) return;

  const text = String(el.textContent || "").trim().toLowerCase();

  if (text.includes("prime audit")) {
    ev.preventDefault();
    ev.stopImmediatePropagation();
    ztxStablePrimeState();
    return false;
  }

  if (text === "refresh") {
    ev.preventDefault();
    ev.stopImmediatePropagation();
    ztxStableRefreshDashboard();
    return false;
  }
}, true);

document.addEventListener("DOMContentLoaded", () => {
  if (location.pathname.includes("dashboard") || location.pathname === "/") {
    ztxStableRefreshDashboard();
    window.setInterval(ztxStableRefreshDashboard, 3000);
  }
});

