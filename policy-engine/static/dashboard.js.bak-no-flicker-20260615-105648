async function ztxScenarioLoadXApps() {
  const sel = $("xappSelect");
  if (!sel) return;

  const health = await apiJson("/health");
  const xapps = asArray(health.xapps);
  sel.innerHTML = xapps.map(x => `<option value="${esc(x)}">${esc(x)}</option>`).join("");
}

function ztxStatePill(state) {
  return pill(esc(state || "UNKNOWN"), stateClass(state));
}

function ztxRenderScenarioGrid(data) {
  const grid = $("scenarioGrid");
  if (!grid) return;

  const scenarios = asArray(data.scenarios);
  if (!scenarios.length) {
    grid.innerHTML = `<div class="small-muted">No scenarios returned by /csm/scenarios</div>`;
    return;
  }

  grid.innerHTML = scenarios.map(s => {
    const id = s.id || "UNKNOWN";
    const target = s.target_xapp || s.default_xapp || "";
    const category = s.category || s.mode || "scenario";
    const expected = s.expected_state || "UNKNOWN";
    const malicious = s.malicious ? "Attack" : "Benign";

    return `
      <div class="scenario-card">
        <div class="scenario-title">${esc(id)} — ${esc(s.name || "")}</div>
        <div class="small-muted">${esc(category)} · ${esc(malicious)}</div>
        <div class="small-muted">Target: <b>${esc(target)}</b></div>
        <div class="small-muted">Expected: ${ztxStatePill(expected)}</div>
        <p>${esc(s.description || "")}</p>
        <button class="btn run-scenario-btn" data-scenario="${esc(id)}" data-xapp="${esc(target)}">
          Run ${esc(id)}
        </button>
      </div>
    `;
  }).join("");

  document.querySelectorAll(".run-scenario-btn").forEach(btn => {
    btn.addEventListener("click", async () => {
      const id = btn.getAttribute("data-scenario");
      const xapp = btn.getAttribute("data-xapp");
      await ztxRunScenario(id, xapp, btn);
    });
  });
}

function ztxRenderEvaluation(summary) {
  const total = Number(summary.total_runs || 0);
  const passed = Number(summary.passed || 0);
  const passRate = total ? ((passed / total) * 100).toFixed(1) + "%" : "--";

  setText("tpCount", summary.TP ?? 0);
  setText("tnCount", summary.TN ?? 0);
  setText("fpCount", summary.FP ?? 0);
  setText("fnCount", summary.FN ?? 0);
  setText("totalRuns", total);

  const passEl = $("evalPassRate");
  if (passEl) {
    passEl.textContent = passRate;
    passEl.className = "overall " + (total === 0 ? "unknown" : (Number(passRate.replace("%","")) >= 80 ? "healthy" : "degraded"));
  }

  const evalBox = $("evaluationBox");
  if (evalBox) evalBox.textContent = JSON.stringify(summary, null, 2);

  const recent = $("recentResults");
  if (recent) {
    const rows = asArray(summary.recent_results);
    if (!rows.length) {
      recent.innerHTML = `<div class="small-muted">No scenario results yet. Run A1/B1/etc.</div>`;
    } else {
      recent.innerHTML = rows.map(r => `
        <div class="event-card">
          <b>${esc(r.scenario_id || "")} — ${esc(r.name || "")}</b>
          <div class="small-muted">
            ${esc(r.xapp || "")} · expected ${esc(r.expected_state || "")} · actual ${esc(r.actual_state || "")}
          </div>
          <div>
            ${pill(esc(r.classification || "N/A"), r.classification === "FP" || r.classification === "FN" ? "compromised" : "healthy")}
            ${pill(r.pass ? "PASS" : "FAIL", r.pass ? "healthy" : "compromised")}
          </div>
        </div>
      `).join("");
    }
  }
}

async function ztxRefreshScenarioConsole() {
  if (document.body?.dataset?.page !== "scenario-console") return;

  const scenarios = await apiJson("/csm/scenarios");
  if (scenarios && scenarios.ok !== false) ztxRenderScenarioGrid(scenarios);

  const summary = await apiJson("/csm/evaluation/summary");
  if (summary && summary.ok !== false) ztxRenderEvaluation(summary);

  await ztxScenarioLoadXApps();
}

async function ztxRunScenario(id, xapp, btn) {
  if (!id) return;

  if (btn) {
    btn.disabled = true;
    btn.textContent = "Running...";
  }

  const result = await apiJson(`/csm/scenarios/${encodeURIComponent(id)}/run`, {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({xapp})
  });

  const box = $("scenarioBox");
  if (box) box.textContent = JSON.stringify(result, null, 2);

  if (btn) {
    btn.disabled = false;
    btn.textContent = `Run ${id}`;
  }

  await ztxRefreshScenarioConsole();
}

async function ztxPrimeAuditScenario() {
  const result = await apiJson("/csm/audit?persist=true", {method: "POST"});
  const box = $("containmentBox");
  if (box) box.textContent = JSON.stringify(result, null, 2);
  await ztxRefreshScenarioConsole();
}

async function ztxClearEvaluation() {
  const result = await apiJson("/csm/evaluation/clear", {method: "POST"});
  const box = $("evaluationBox");
  if (box) box.textContent = JSON.stringify(result, null, 2);
  await ztxRefreshScenarioConsole();
}

async function ztxVerifySelectedXApp() {
  const xapp = $("xappSelect")?.value;
  if (!xapp) return;
  const result = await apiJson("/csm/containment/verify", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({xapp})
  });
  const box = $("containmentBox");
  if (box) box.textContent = JSON.stringify(result, null, 2);
}

async function ztxRestoreSelectedXApp() {
  const xapp = $("xappSelect")?.value;
  if (!xapp) return;
  const result = await apiJson("/csm/containment/restore", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({xapp})
  });
  const box = $("containmentBox");
  if (box) box.textContent = JSON.stringify(result, null, 2);
  await ztxRefreshScenarioConsole();
}

document.addEventListener("DOMContentLoaded", () => {
  if (document.body?.dataset?.page !== "scenario-console") return;

  $("refreshBtn")?.addEventListener("click", ztxRefreshScenarioConsole);
  $("primeAuditBtn")?.addEventListener("click", ztxPrimeAuditScenario);
  $("clearEvalBtn")?.addEventListener("click", ztxClearEvaluation);
  $("verifyBtn")?.addEventListener("click", ztxVerifySelectedXApp);
  $("restoreBtn")?.addEventListener("click", ztxRestoreSelectedXApp);

  ztxRefreshScenarioConsole();
});


// ------------------------------------------------------------
// ZTX_PATCH_RUNTIME_TABLE_ALIGNMENT_FAST
// Fixes column mismatch, removes separate isolated/quarantine confusion,
// and refreshes using only fast APIs.
// ------------------------------------------------------------

function ztxNum(v) {
  const n = Number(v);
  return Number.isFinite(n) ? n : null;
}

function ztxFmtScore(v) {
  const n = ztxNum(v);
  return n === null ? "N/A" : String(Math.round(n));
}

function ztxFmtCpu(resources) {
  const v = ztxNum(resources?.cpu_percent_1core ?? resources?.cpu_percent_1core_2m);
  return v === null ? "N/A" : `${v.toFixed(1)}%`;
}

function ztxFmtMem(resources) {
  const b = ztxNum(resources?.memory_working_set_bytes ?? resources?.memory_usage_bytes);
  if (b === null) return "N/A";
  return `${(b / 1024 / 1024).toFixed(1)} Mi`;
}

function ztxBoolPill(value) {
  return value
    ? `<span class="pill compromised">YES</span>`
    : `<span class="pill healthy">NO</span>`;
}

function ztxStateClassLocal(state) {
  const s = String(state || "UNKNOWN").toUpperCase();
  if (s === "TRUSTED" || s === "RESTORED") return "healthy";
  if (s === "OBSERVED") return "observed";
  if (s === "SUSPICIOUS") return "suspicious";
  if (s === "COMPROMISED" || s === "QUARANTINED") return "compromised";
  return "unknown";
}

function ztxPill(text, cls) {
  return `<span class="pill ${cls || "unknown"}">${esc(text)}</span>`;
}

function ztxMergeByXapp(statePayload, runtimePayload) {
  const stateByXapp = {};
  asArray(statePayload?.xapps).forEach(x => {
    if (x?.xapp) stateByXapp[x.xapp] = x;
  });

  return asArray(runtimePayload?.rows).map(r => {
    const s = stateByXapp[r.xapp] || {};
    return { runtime: r, trust: s };
  });
}

function ztxEffectiveContainment(r, s) {
  const c = r?.containment || {};
  if (c.contained === true) return true;

  const service = r?.service || {};
  const pod = r?.pod || {};

  const quarantineMarked =
    c.quarantine_marked === true ||
    c.pod_labelled_quarantined === true ||
    pod.quarantine_label === true;

  const serviceIsolated =
    c.service_isolated === true ||
    service.has_endpoints === false ||
    Number(service.endpoint_count) === 0;

  return quarantineMarked && serviceIsolated;
}

function ztxCanonicalScores(s) {
  let risk = ztxNum(s?.risk_score);
  let trust = ztxNum(s?.trust_score);
  const raw = ztxNum(s?.score);
  const scoreType = String(s?.score_type || "").toLowerCase();
  const state = String(s?.state || "UNKNOWN").toUpperCase();

  if (risk === null && trust === null && raw !== null) {
    if (scoreType.includes("risk")) {
      risk = raw;
      trust = 100 - risk;
    } else if (scoreType.includes("trust")) {
      trust = raw;
      risk = 100 - trust;
    } else if (state === "TRUSTED" || state === "RESTORED") {
      trust = raw;
      risk = 100 - trust;
    } else if (state === "COMPROMISED" || state === "QUARANTINED") {
      risk = 100;
      trust = 0;
    } else {
      trust = raw;
      risk = 100 - trust;
    }
  }

  if (risk === null && trust !== null) risk = 100 - trust;
  if (trust === null && risk !== null) trust = 100 - risk;

  if (state === "TRUSTED" || state === "RESTORED") {
    risk = 0;
    trust = 100;
  }
  if (state === "COMPROMISED" || state === "QUARANTINED") {
    risk = 100;
    trust = 0;
  }

  return { risk, trust };
}

async function ztxFastRefreshDashboard() {
  const statePromise = apiJson("/csm/state");
  const runtimePromise = apiJson("/csm/xapps/runtime-lite?namespace=ricxapp");

  const [statePayload, runtimePayload] = await Promise.allSettled([statePromise, runtimePromise]);

  const state = statePayload.status === "fulfilled" ? statePayload.value : {};
  const runtime = runtimePayload.status === "fulfilled" ? runtimePayload.value : {};

  const rows = ztxMergeByXapp(state, runtime);

  const overall = state?.overall_state || "INITIALIZING";
  setText("overallState", overall);

  const summary = state?.summary || {};
  setText("trustedCount", summary.TRUSTED ?? 0);
  setText("observedCount", summary.OBSERVED ?? 0);
  setText("suspiciousCount", summary.SUSPICIOUS ?? 0);
  setText("compromisedCount", summary.COMPROMISED ?? 0);
  setText("quarantinedCount", summary.QUARANTINED ?? 0);

  const tbody =
    $("runtimeBody") ||
    document.querySelector("#runtimeTable tbody") ||
    document.querySelector("table tbody");

  if (!tbody) return;

  if (!rows.length) {
    tbody.innerHTML = `<tr><td colspan="12">No runtime rows returned yet.</td></tr>`;
    return;
  }

  tbody.innerHTML = rows.map(({ runtime: r, trust: s }) => {
    const pod = r.pod || {};
    const svc = r.service || {};
    const res = r.resources || {};

    const stateText = s.state || "UNKNOWN";
    const scores = ztxCanonicalScores(s);
    const contained = ztxEffectiveContainment(r, s);

    const endpointCount = svc.endpoint_count ?? "N/A";
    const podName = pod.name || "N/A";
    const readyText = pod.ready_text || "N/A";

    return `
      <tr>
        <td><b>${esc(r.xapp || "unknown")}</b></td>
        <td>${ztxPill(stateText, ztxStateClassLocal(stateText))}</td>
        <td>${ztxFmtScore(scores.risk)}</td>
        <td>${ztxFmtScore(scores.trust)}</td>
        <td>${ztxFmtCpu(res)}</td>
        <td>${ztxFmtMem(res)}</td>
        <td>${esc(podName)}</td>
        <td>${esc(readyText)}</td>
        <td>${esc(endpointCount)}</td>
        <td>${ztxBoolPill(contained)}</td>
        <td>
          <button class="btn analyze-btn" data-xapp="${esc(r.xapp || "")}">Analyze</button>
        </td>
      </tr>
    `;
  }).join("");

  const updated = $("updatedAt") || $("runtimeUpdatedAt");
  if (updated) updated.textContent = "Updated " + new Date().toLocaleTimeString();
}

// Override old refresh loop with faster one.
window.refreshDashboard = ztxFastRefreshDashboard;
window.refreshRuntime = ztxFastRefreshDashboard;

document.addEventListener("DOMContentLoaded", () => {
  if (location.pathname.includes("dashboard") || location.pathname === "/") {
    ztxFastRefreshDashboard();
    setInterval(ztxFastRefreshDashboard, 3000);
  }
});



// ------------------------------------------------------------
// ZTX_PATCH_DASHBOARD_STABLE_REFRESH_V2
// Final stable dashboard renderer:
// - prevents old 15s dashboard interval flicker
// - avoids clearing table while refreshing
// - uses only fast APIs
// - shows one effective Containment column
