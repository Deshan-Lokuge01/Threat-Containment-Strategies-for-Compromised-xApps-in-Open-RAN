/* ZTX_DASHBOARD_SAFE_RESTORE_V1 */

const $ = (id) => document.getElementById(id);
const RUNTIME_NAMESPACE = "ricxapp";
const AUTO_REFRESH_MS = 15000;

function asArray(value) {
  return Array.isArray(value) ? value : [];
}

function asObject(value) {
  return value && typeof value === "object" && !Array.isArray(value) ? value : {};
}

function isNumeric(value) {
  return value !== null && value !== undefined && value !== "" && Number.isFinite(Number(value));
}

function hasZeroEndpoints(value) {
  return isNumeric(value) && Number(value) === 0;
}

function hasPositiveEndpoints(value) {
  return isNumeric(value) && Number(value) > 0;
}

function num(value, digits = 2) {
  if (!isNumeric(value)) return "N/A";
  return Number(value).toFixed(digits);
}

function bytes(value) {
  if (!isNumeric(value)) return "N/A";
  const n = Number(value);
  if (n >= 1024 * 1024 * 1024) return `${(n / (1024 * 1024 * 1024)).toFixed(2)} GiB`;
  if (n >= 1024 * 1024) return `${(n / (1024 * 1024)).toFixed(1)} MiB`;
  if (n >= 1024) return `${(n / 1024).toFixed(1)} KiB`;
  return `${n} B`;
}

function setStatus(message) {
  const el = $("lastUpdated");
  if (el) el.textContent = message;
}

async function apiJson(url, options = {}) {
  try {
    const res = await fetch(url, options);
    const text = await res.text();
    try {
      const data = JSON.parse(text);
      if (!res.ok) {
        console.error(`[dashboard] API request failed: ${url}`, { status: res.status, error: data });
        return { ok: false, status: res.status, error: data };
      }
      return data;
    } catch (e) {
      console.error(`[dashboard] API returned non-JSON: ${url}`, { status: res.status, body: text.slice(0, 500) });
      return {
        ok: false,
        status: res.status,
        error: "non_json_response",
        body: text.slice(0, 500)
      };
    }
  } catch (e) {
    console.error(`[dashboard] API fetch failed: ${url}`, e);
    return {
      ok: false,
      error: "fetch_failed",
      message: e && e.message ? e.message : String(e)
    };
  }
}

function setText(id, value) {
  const el = $(id);
  if (el) el.textContent = value ?? 0;
}

function stateClass(state) {
  const s = String(state || "UNKNOWN").toUpperCase();
  if (s === "HEALTHY" || s === "TRUSTED" || s === "RESTORED") return "healthy";
  if (s === "OBSERVED") return "observed";
  if (s === "SUSPICIOUS" || s === "DEGRADED") return "degraded";
  if (s === "COMPROMISED") return "compromised";
  if (s === "QUARANTINED" || s === "CONTAINED") return "contained";
  return "unknown";
}

function pill(text, cls) {
  return `<span class="pill ${cls || ""}">${text}</span>`;
}

function esc(v) {
  return String(v ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function runtimeErrorHtml(label, detail) {
  const pretty = detail === undefined ? "" : `\n<pre>${esc(JSON.stringify(detail, null, 2))}</pre>`;
  return `
    <tr>
      <td colspan="12">
        ${esc(label)}${pretty}
      </td>
    </tr>
  `;
}

let trustIndex = {};
let refreshTimer = null;
let refreshInFlight = null;

async function refreshState() {
  const state = await apiJson("/csm/state");
  trustIndex = {};

  if (!state || state.ok === false || state.error) {
    setText("overallState", "UNKNOWN");
    if ($("overallState")) {
      $("overallState").className = "overall unknown";
    }
    setText("trustedCount", 0);
    setText("observedCount", 0);
    setText("suspiciousCount", 0);
    setText("compromisedCount", 0);
    setText("quarantinedCount", 0);
    return { ok: false, error: state?.error || "state_fetch_failed" };
  }

  const xapps = asArray(state.xapps).length
    ? asArray(state.xapps)
    : asArray(state.rows).length
      ? asArray(state.rows)
      : asArray(state.items);
  xapps.forEach((x) => {
    const item = asObject(x);
    if (item.xapp) trustIndex[item.xapp] = item;
  });

  const summary = asObject(state.summary);
  const overall = state.overall_state || "UNKNOWN";

  setText("overallState", overall);
  if ($("overallState")) {
    $("overallState").className = `overall ${stateClass(overall)}`;
  }

  setText("trustedCount", summary.TRUSTED || 0);
  setText("observedCount", summary.OBSERVED || 0);
  setText("suspiciousCount", summary.SUSPICIOUS || 0);
  setText("compromisedCount", summary.COMPROMISED || 0);
  setText("quarantinedCount", summary.QUARANTINED || 0);

  return { ok: true, xapps: xapps.length };
}

async function refreshRuntimeTable() {
  const body = $("runtimeTableBody");
  if (!body) return;

  const data = await apiJson(`/csm/xapps/runtime-lite?namespace=${encodeURIComponent(RUNTIME_NAMESPACE)}`);

  if (!data || data.error || data.ok === false) {
    body.innerHTML = runtimeErrorHtml("Runtime API error", data);
    return { ok: false, error: data?.error || "runtime_fetch_failed" };
  }

  const rows = asArray(data.rows).length
    ? asArray(data.rows)
    : asArray(data.xapps).length
      ? asArray(data.xapps)
      : asArray(data.items);

  if (!rows.length) {
    body.innerHTML = `<tr><td colspan="12">No xApps found from runtime API.</td></tr>`;
    return { ok: true, rows: 0 };
  }

  body.innerHTML = "";

  rows.forEach((item, index) => {
    try {
      const r = asObject(item);
      const xapp = String(r.xapp || `unknown-xapp-${index + 1}`);
      const pod = asObject(r.pod);
      const svc = asObject(r.service);
      const cont = asObject(r.containment);
      const resources = asObject(r.resources);
      const trust = asObject(r.trust || trustIndex[xapp]);

      let trustState = trust.state || trust.detection_state || trust.decision_state || r.trust_state || "UNKNOWN";
      let riskScore = trust.risk_score ?? trust.score ?? r.risk_score ?? r.score;
      let trustScore = trust.trust_score ?? r.trust_score;

      const endpoints = svc.endpoint_count;
      const endpointsZero = hasZeroEndpoints(endpoints);
      const isolated = Boolean(cont.service_isolated) || endpointsZero;
      const contained = Boolean(cont.contained) || endpointsZero;
      const quarantined = Boolean(
        cont.pod_labelled_quarantined ??
        cont.quarantine_marked ??
        pod.quarantine_label
      );

      if (contained || isolated || quarantined) {
        trustState = "QUARANTINED";
        riskScore = riskScore ?? 100;
        trustScore = trustScore ?? 0;
      } else if (String(trustState).toUpperCase() === "UNKNOWN" && pod.ready && hasPositiveEndpoints(endpoints)) {
        trustState = "TRUSTED";
        riskScore = riskScore ?? 0;
        trustScore = trustScore ?? 100;
      }

      const cpu = resources.cpu_percent_1core ?? resources.cpu_percent_1core_2m;
      const memory = resources.memory_working_set_bytes ?? resources.memory_usage_bytes;
      const cpuDisplay = isNumeric(cpu) ? `${num(cpu, 2)}%` : "N/A";

      const row = document.createElement("tr");
      row.id = xapp;
      row.className = contained || isolated || quarantined ? "row-contained" : "";

row.innerHTML = `
        <td><strong>${esc(xapp)}</strong></td>
        <td>${pill(esc(trustState), stateClass(trustState))}</td>
        <td>${isNumeric(riskScore) ? esc(Number(riskScore)) : "N/A"}</td>
        <td>${isNumeric(trustScore) ? esc(Number(trustScore)) : "N/A"}</td>
        <td>${cpuDisplay}</td>
        <td>${bytes(memory)}</td>
        <td class="mono">${esc(pod.name || "missing")}</td>
        <td>${pod.ready ? pill(esc(pod.ready_text || "Ready"), "healthy") : pill(esc(pod.ready_text || "Not Ready"), "bad")}</td>
        <td>${endpointsZero ? pill("0", "bad") : pill(esc(endpoints ?? "?"), hasPositiveEndpoints(endpoints) ? "healthy" : "unknown")}</td>
        <td>${isolated ? pill("YES", "contained") : pill("NO", "healthy")}</td>
        <td>${quarantined ? pill("YES", "contained") : pill("NO", "healthy")}</td>
        <td style="display: flex; gap: 0.4rem;">
          <button class="btn secondary" style="padding:4px 10px;font-size:.75rem" onclick="window.location.href='/analyze?xapp=${encodeURIComponent(xapp)}&pod=${encodeURIComponent(pod.name || '')}'">Analyze</button>
        </td>
      `;

      body.appendChild(row);
    } catch (e) {
      console.error("[dashboard] Runtime row render failed", { index, row: item, error: e });
      body.innerHTML += runtimeErrorHtml(`Runtime row render error at index ${index}`, {
        row: item,
        error: e && e.message ? e.message : String(e)
      });
    }
  });

  return { ok: true, rows: rows.length };
}

async function primeAudit() {
  await apiJson("/csm/audit?persist=true");
  await refreshAll();
}

async function refreshAll() {
  if (refreshInFlight) return refreshInFlight;

  refreshInFlight = (async () => {
    const errors = [];
    const startedAt = new Date();
    const [stateSettled, runtimeSettled] = await Promise.allSettled([
      refreshState(),
      refreshRuntimeTable()
    ]);

    const stateResult = stateSettled.status === "fulfilled"
      ? stateSettled.value
      : (errors.push({ stage: "state", error: stateSettled.reason?.message || String(stateSettled.reason) }), { ok: false, error: "state_exception" });

    const runtimeResult = runtimeSettled.status === "fulfilled"
      ? runtimeSettled.value
      : (errors.push({ stage: "runtime", error: runtimeSettled.reason?.message || String(runtimeSettled.reason) }), { ok: false, error: "runtime_exception" });

    const failedApis = [];
    if (stateResult?.ok === false) failedApis.push("state");
    if (runtimeResult?.ok === false) failedApis.push("runtime");

    if (failedApis.length) {
      setStatus(`API error: ${failedApis.join(", ")} | ${startedAt.toLocaleTimeString()}`);
    } else {
      setStatus(`Updated ${startedAt.toLocaleTimeString()}`);
    }

    if (!runtimeResult?.ok && $("runtimeTableBody") && errors.length) {
      $("runtimeTableBody").innerHTML = runtimeErrorHtml("Dashboard JS error", {
        stateResult,
        runtimeResult,
        errors
      });
    }

    return { stateResult, runtimeResult };
  })();

  try {
    return await refreshInFlight;
  } finally {
    refreshInFlight = null;
    if (refreshTimer) clearTimeout(refreshTimer);
    refreshTimer = setTimeout(() => {
      refreshAll();
    }, AUTO_REFRESH_MS);
  }
}

document.addEventListener("DOMContentLoaded", async () => {
  $("refreshBtn")?.addEventListener("click", refreshAll);
  $("primeAuditBtn")?.addEventListener("click", primeAudit);

  await refreshAll();
});

