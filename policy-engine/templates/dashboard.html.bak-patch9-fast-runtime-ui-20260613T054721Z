<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>ZT-XGuard Runtime Security Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/static/dashboard.css">
</head>
<body data-page="dashboard">
  <header class="topbar">
    <div>
      <div class="eyebrow">5</div>
      <h1>Runtime Security Dashboard</h1>
      <p class="subtitle">Live xApp runtime, trust-state, service-path, and containment view for the O-RAN Near-RT RIC.</p>
    </div>
    <nav class="top-actions">
      <a class="btn secondary" href="/dashboard">Runtime Dashboard</a>
      <a class="btn secondary" href="/scenario-console">Attack Simulation</a>
      <button id="primeAuditBtn" class="btn">Prime Audit</button>
      <button id="refreshBtn" class="btn secondary">Refresh</button>
    </nav>
  </header>

  <main class="layout">
    <section class="panel hero">
      <div>
        <div class="label">Overall Trust State</div>
        <div id="overallState" class="overall unknown">LOADING</div>
      </div>
      <div class="summary-grid">
        <div class="metric good"><span id="trustedCount">0</span><small>Trusted</small></div>
        <div class="metric info"><span id="observedCount">0</span><small>Observed</small></div>
        <div class="metric warn"><span id="suspiciousCount">0</span><small>Suspicious</small></div>
        <div class="metric bad"><span id="compromisedCount">0</span><small>Compromised</small></div>
        <div class="metric purple"><span id="quarantinedCount">0</span><small>Quarantined</small></div>
      </div>
    </section>

    <section class="panel">
      <div class="section-head">
        <div>
          <h2>xApp Runtime Table</h2>
        </div>
        <div id="lastUpdated" class="small-muted">Not updated yet</div>
      </div>

      <div class="table-wrap">
        <table class="runtime-table">
          <thead>
            <tr>
              <th>xApp</th>
              <th>State</th>
              <th>Risk</th>
              <th>Trust</th>
              <th>CPU</th>
              <th>Memory</th>
              <th>Pod</th>
              <th>Ready</th>
              <th>Endpoints</th>
              <th>Isolated</th>
              <th>Quarantine</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="runtimeTableBody">
            <tr><td colspan="12">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script src="/static/dashboard.js"></script>
</body>
</html>
