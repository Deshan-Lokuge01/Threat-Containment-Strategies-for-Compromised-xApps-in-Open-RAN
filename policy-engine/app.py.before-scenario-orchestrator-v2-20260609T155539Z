    payload = request.get_json(force=True, silent=True) or {}
    namespace = payload.get("namespace") or XAPP_NAMESPACE
    xapp = payload.get("xapp")
    pod_name = payload.get("pod") or payload.get("pod_name")
    reason = payload.get("reason") or "manual_csm_quarantine"
    incident_id = payload.get("incident_id") or f"{utc_id()}-manual-quarantine-{safe_name(xapp or pod_name or 'unknown')}"

    pod = None

    if pod_name:
        pod = get_pod_by_name(pod_name, namespace)
    elif xapp:
        pod = get_primary_pod_for_xapp(xapp, namespace)
        pod_name = pod.metadata.name if pod else None

    if not pod_name:
        return jsonify({
            "applied": False,
            "error": "pod_not_found",
            "xapp": xapp,
            "namespace": namespace,
        }), 404

    started = time.time()
    quarantine = apply_quarantine(pod_name, namespace, reason, incident_id)
    quarantine_ms = round((time.time() - started) * 1000, 3)

    detected_xapp = xapp or xapp_from_pod(pod, pod_name)

    result = {
        "xapp": detected_xapp,
        "namespace": namespace,
        "state": "QUARANTINED",
        "score": 0,
        "pod": pod_name,
        "findings": [{
            "severity": "critical",
            "signal": "manual_quarantine",
            "message": reason,
            "score_penalty": 100,
        }],
        "time": utc_now(),
    }

    csm_update_from_result(result, source="manual_quarantine")

    return jsonify({
        "applied": True,
        "xapp": detected_xapp,
        "pod_name": pod_name,
        "namespace": namespace,
        "quarantine": quarantine,
        "quarantine_ms": quarantine_ms,
        "incident_id": incident_id,
    })


