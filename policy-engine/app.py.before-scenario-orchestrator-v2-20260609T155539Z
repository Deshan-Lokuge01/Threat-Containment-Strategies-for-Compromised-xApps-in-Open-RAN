@APP.route("/csm/containment/restore", methods=["POST"])
def csm_containment_restore() -> Any:
    payload = request.get_json(force=True, silent=True) or {}

    namespace = payload.get("namespace") or XAPP_NAMESPACE
    xapp = payload.get("xapp")

    if not xapp:
        return jsonify({
            "restored": False,
            "error": "xapp_required",
        }), 400

    service_restore = restore_service_isolation(xapp, namespace)
    scale_restore = restore_deployment_scale(xapp, namespace)

    # Remove quarantine labels/annotations from all current pods of the xApp.
    pod_results = []
    for pod in get_pods_for_xapp(xapp, namespace):
        pod_name = pod.metadata.name
        patch = {
            "metadata": {
                "labels": {
                    "zt-xguard.io/quarantine": None,
                    "security-status": None,
                    "zt-xguard.io/decision": None,
                },
                "annotations": {
                    "zt-xguard.io/quarantine-reason": None,
                    "zt-xguard.io/quarantine-time": None,
                    "zt-xguard.io/incident-id": None,
                },
            }
        }
        try:
            CORE.patch_namespaced_pod(name=pod_name, namespace=namespace, body=patch)
            pod_results.append({"pod": pod_name, "labels_removed": True})
        except Exception as exc:
            pod_results.append({"pod": pod_name, "labels_removed": False, "error": str(exc)})

    verify = verify_xapp_containment(xapp, namespace)

    return jsonify({
        "restored": service_restore.get("restored", False) or scale_restore.get("restored", False) or any(p.get("labels_removed") for p in pod_results),
        "xapp": xapp,
        "namespace": namespace,
        "service_restore": service_restore,
        "scale_restore": scale_restore,
        "pod_label_restore": pod_results,
        "verification_after_restore": verify,
        "time": utc_now(),
    })


